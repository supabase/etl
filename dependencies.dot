// Internal workspace dependencies. External packages are omitted.
digraph dependencies {
    rankdir=LR;
    node [shape=box];
    "etl";
    "etl" -> "etl-config";
    "etl" -> "etl-postgres";
    "etl-benchmarks";
    "etl-benchmarks" -> "etl";
    "etl-benchmarks" -> "etl-config";
    "etl-benchmarks" -> "etl-destinations";
    "etl-benchmarks" -> "etl-postgres";
    "etl-benchmarks" -> "etl-telemetry";
    "etl-config";
    "etl-destinations";
    "etl-destinations" -> "etl";
    "etl-destinations" -> "etl-config";
    "etl-destinations" -> "etl-maintenance";
    "etl-examples";
    "etl-examples" -> "etl";
    "etl-examples" -> "etl-config";
    "etl-examples" -> "etl-destinations";
    "etl-maintenance";
    "etl-maintenance" -> "etl";
    "etl-maintenance" -> "etl-config";
    "etl-postgres";
    "etl-postgres" -> "etl-config";
    "etl-replicator";
    "etl-replicator" -> "etl";
    "etl-replicator" -> "etl-config";
    "etl-replicator" -> "etl-destinations";
    "etl-replicator" -> "etl-maintenance";
    "etl-replicator" -> "etl-telemetry";
    "etl-telemetry";
    "etl-telemetry" -> "etl-config";
    "xtask";
    "xtask" -> "etl-config";
}
